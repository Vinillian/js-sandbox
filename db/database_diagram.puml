
@startuml
!theme cerulean
!define table(x) class x << (T,#FFAAAA) >>
!define primary_key(x) <b><color:red>x</color></b>
!define foreign_key(x) <color:blue>x</color>
!define column(x) x
!define constraint(x) <i>x</i>

' Устанавливаем горизонтальное расположение
left to right direction

' Определяем таблицы как классы
table(customers) {
    primary_key(id): SERIAL
    --
    name: VARCHAR(100)
    email: VARCHAR(100)
    city: VARCHAR(50)
}

table(products) {
    primary_key(id): SERIAL
    --
    name: VARCHAR(100)
    price: NUMERIC(10,2)
}

table(orders) {
    primary_key(id): SERIAL
    --
    foreign_key(customer_id): INTEGER
    order_date: DATE
    status: VARCHAR(20)
}

table(order_items) {
    primary_key(id): SERIAL
    --
    foreign_key(order_id): INTEGER
    foreign_key(product_id): INTEGER
    quantity: INTEGER
    price_at_order: NUMERIC(10,2)
}

' Описываем связи
customers ||--o{ orders : "1 : N"
orders ||--o{ order_items : "1 : N"
products ||--o{ order_items : "1 : N"

@enduml